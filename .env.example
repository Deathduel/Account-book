# ============================================
# 方案 A：云端部署配置（Vercel + Supabase）
# 本地开发不填也能直接运行（自动读写 data/ledger.json）
# ============================================

# 1. Supabase 项目配置（在 Supabase Dashboard -> Project Settings -> API 获取）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 2. 可选：单人访问密码（设置后打开网页需输入密码，一次输入 30 天免登）
APP_PIN=
APP_AUTH_SECRET=change-this-to-a-random-string
